input {
    keyboard {
        xkb {
            layout "latam"
        }
    }
    touchpad {
        tap-to-click true
        dwt true
    }
}
binds {
    Mod+Shift+Slash { spawn "dms" "ipc" "call" "help"; }
    // Quit
    Mod+Shift+E { quit; }
    // Windows
    Mod+Q { close-window; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+T { toggle-window-state; }
    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }
    // Move windows
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-or-workspace-down; }
    Mod+Shift+Up    { move-window-or-workspace-up; }
    Mod+Shift+Right { move-column-right; }
    // Workspaces 1-9
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    // Layout
    Mod+R { switch-preset-column-width; }
    Mod+F { switch-focus-lock; }
    Mod+W { switch-prevent-orphan-columns; }
    // Launcher
    Mod+D { spawn "dsearch"; }
    // Terminal
    Mod+Return { spawn "foot"; }
    // DMS IPC — Audio
    XF86AudioRaiseVolume { spawn "dms" "ipc" "call" "audio" "increment"; }
    XF86AudioLowerVolume { spawn "dms" "ipc" "call" "audio" "decrement"; }
    XF86AudioMute { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute { spawn "dms" "ipc" "call" "audio" "mic-mute"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    // DMS IPC — Brightness
    XF86MonBrightnessUp { spawn "dms" "ipc" "call" "brightness" "increment"; }
    XF86MonBrightnessDown { spawn "dms" "ipc" "call" "brightness" "decrement"; }
    // DMS IPC — Color temperature (night mode)
    XF86Red {
        spawn "dms" "ipc" "call" "nightmode" "toggle";
    }
    // Screenshot
    Print { spawn "satty" "--output" "current"; }
    Shift+Print { spawn "satty" "--output" "region"; }
    // Clipboard
    Mod+Shift+V { spawn "dms" "ipc" "call" "clipboard" "show"; }
    // Extra
    XF86Search { spawn "dsearch"; }
    Mod+T      { spawn "foot" "-T" "float"; }
}
layout {
    gaps 8 8 8 8
}
window-rules {
    match app-id="Satty" { open-floating true; }
    match app-id="float-term" { open-floating true; }
    match app-id="foot" title="float" { open-floating true; }
}
spawn-at-startup {
    { spawn "dms"; }
    { spawn "iio-niri"; }
    { spawn "fcitx5"; }
    { spawn "udiskie"; }
}
